import React from "react";
import { createRoot } from "react-dom/client";

import App from "./containers/app";

const rootElement = document.getElementById("root");

if (!rootElement) {
    throw new Error("NuclearMod: #root element was not found.");
}

const root = createRoot(rootElement);

root.render(
    <React.StrictMode>
        <App />
    </React.StrictMode>
);
import React from "react";
import "./app.css";

const App = () => {
    return (
        <div className="nuclearmod-app">
            <header className="nuclearmod-header">
                <h1>💣 NuclearMod</h1>
                <span>Editor</span>
            </header>

            <main className="nuclearmod-main">
                <aside className="nuclearmod-sidebar">
                    <button>🧱 Code</button>
                    <button>🎨 Costumes</button>
                    <button>🔊 Sounds</button>
                </aside>

                <section className="nuclearmod-workspace">
                    <div className="stage">
                        <div className="stage-placeholder">
                            Stage
                        </div>
                    </div>

                    <div className="blocks">
                        <h2>Code</h2>
                        <p> blocks will appear here.</p>
                    </div>
                </section>
            </main>
        </div>
    );
};

export default App;
.nuclearmod-app {
    min-height: 100vh;
    background: #f5f5f5;
    color: #222;
    font-family: Arial, sans-serif;
}

.nuclearmod-header {
    height: 56px;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 0 20px;
    background: #ffffff;
    border-bottom: 1px solid #ddd;
}

.nuclearmod-header h1 {
    margin: 0;
    font-size: 22px;
}

.nuclearmod-header span {
    color: #777;
}

.nuclearmod-main {
    display: flex;
    min-height: calc(100vh - 56px);
}

.nuclearmod-sidebar {
    width: 180px;
    padding: 16px;
    background: #ffffff;
    border-right: 1px solid #ddd;
}

.nuclearmod-sidebar button {
    display: block;
    width: 100%;
    margin-bottom: 10px;
    padding: 10px;
    border: 0;
    border-radius: 8px;
    background: #eee;
    cursor: pointer;
}

.nuclearmod-workspace {
    flex: 1;
    display: flex;
    gap: 20px;
    padding: 20px;
}

.stage {
    width: 480px;
    height: 360px;
    background: #ffffff;
    border: 1px solid #ccc;
}

.stage-placeholder {
    display: grid;
    place-items: center;
    height: 100%;
    color: #999;
}

.blocks {
    flex: 1;
    background: #ffffff;
    border: 1px solid #ccc;
    padding: 20px;
}
const NUKE_EXTENSION = ".nuke";

export function isNukeProject(filename) {
    return filename.toLowerCase().endsWith(NUKE_EXTENSION);
}

export function getNukeFilename(name) {
    if (name.toLowerCase().endsWith(NUKE_EXTENSION)) {
        return name;
    }

    return `${name}${NUKE_EXTENSION}`;
}

export function createNukeProject(projectData) {
    return JSON.stringify({
        format: "NuclearMod",
        version: 1,
        project: projectData
    });
}

export function parseNukeProject(contents) {
    const data = JSON.parse(contents);

    if (data.format !== "NuclearMod") {
        throw new Error("Invalid .nuke project file.");
    }

    return data;
}